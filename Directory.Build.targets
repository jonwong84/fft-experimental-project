<Project>
  <!-- A narrow allowlist for today's engine projects, including evaluated/imported references. -->
  <Target Name="CheckZodiacProjectBoundary" BeforeTargets="ResolveProjectReferences;CoreCompile"
          Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Zodiac.Engine'))">
    <ItemGroup>
      <_ForbiddenZodiacReference Include="@(ProjectReference)"
          Condition="'%(ProjectReference.Filename)' != 'Zodiac.Engine'" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenZodiacReference)' != ''"
           Text="Zodiac engine boundary violation: $(MSBuildProjectName) may reference only Zodiac.Engine; forbidden references: @(_ForbiddenZodiacReference). FFT dependencies belong in the game layer." />
  </Target>
</Project>
