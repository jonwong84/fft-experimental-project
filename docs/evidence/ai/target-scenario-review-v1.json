  "findings": [
    {
      "id": "TARGET-433-01",
      "disposition": "verified-within-domain",
      "finding": "Live untargetability, cached out-of-play, ELIGIBLE_ENEMY nearest, active target filters and imminent proximity retain distinct predicates; source-order nearest ties and actor fallback are preserved."
    },
    {
      "id": "TARGET-433-02",
      "disposition": "verified-within-domain",
      "finding": "Restored live CT/coordinates drive delays and target geometry; flat forward occupancy differs from reverse target-distance propagation. Slot, movement-record and compact AI extents remain distinct."
    },
    {
      "id": "TARGET-433-03",
      "disposition": "verified-within-domain",
      "finding": "Scenario filtering/fallback, signed packed keys, last tile ties, post-ACT D1 copy, ranged floor, non-Blue adjustment order, pre-insertion mask complement and unknown priorities match admitted source branches."
    },
    {
      "id": "TARGET-433-04",
      "disposition": "verified-within-domain",
      "finding": "Current-origin ordinary magic masks preserve CT groups, source aim order and Follow center XOR within the dry single-sheet/radius<=7 domain; all32768 row-template/Manhattan comparisons match."
    },
    {
      "id": "TARGET-433-05",
      "disposition": "deferred",
      "finding": "Other nearest modes/special policies, nonflat terrain and source overread radii, full origin/aim consumption and rank/lottery/commands, statuses/corpse lifecycle and frame RNG remain separate. Next bounded review434; final readability gate432 remains waiting."
    }
