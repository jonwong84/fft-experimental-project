  "findings": [
    {
      "id": "PREP-431-01",
      "disposition": "confirmed-defect-fixed",
      "finding": "HP-only behavior with neither target-side preference was None instead of Useful. Absolute exclusions and both-flag enemy precedence remain intact; ready-hit scoring proceeds without a side credit/penalty."
    },
    {
      "id": "PREP-431-02",
      "disposition": "confirmed-defect-fixed",
      "finding": "Special skillset menus could enter default spell list/loading via ordinary-looking ability IDs. Shared original-menu admission now guards list, loader and catalog; special menu implementations remain deferred."
    },
    {
      "id": "PREP-431-03",
      "disposition": "verified-within-domain",
      "finding": "Resolved learning/static usability/max-MP initialization versus current MP, repeated occurrences, Frog/Monster Skill statistics, primary versus secondary flags, CT support quirk and working usage ordering."
    },
    {
      "id": "PREP-431-04",
      "disposition": "verified-within-domain",
      "finding": "Stable enemy relation, strict HP thresholds, retained policies/team support, first-minimum support-share override and reaches/counts before post-ACT clear; old certified pair consumers remain narrow."
    },
    {
      "id": "PREP-431-05",
      "disposition": "verified-within-domain",
      "finding": "Fresh useful masks and source-order Accumulate parity draws for active allies; no enemy draws or input publication; late budget rejection retains entry state/RNG."
    },
    {
      "id": "PREP-431-06",
      "disposition": "deferred",
      "finding": "Special menu/status/equipment/item policies, stale Innocent cache quirk outside certified domain, full selection/origin/ranking/commands and frame RNG; readability gate432 remains waiting for full port."
    }
