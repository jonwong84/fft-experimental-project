  "findings": {
    "unconditional": "Clear result then draw before all status/execute guards; healthy or suppressed upkeep still draws1",
    "reraise": "Dead and not Undead plus Reraise stages removal of Dead/Reraise, floor(maxHP/10) healing and return2 before execute/immortal guards; no second draw",
    "deathCounter": "Execution-only, excluding immortal or save/load-formation units. old1->0 returns0; old0 underflows local byte to255 then expires without storing255.",
    "undead": "Expired Undead revives on odd first raw, then draws again for floor(raw*maxHP/32768)+1 signed16 healing; otherwise uses first raw pickup-mask bits.",
    "pickup": "Crystal iff first raw &0x10 nonzero, or &0x110 when initial player-controlled flag set; otherwise Treasure. Return1 stages statuses, not pickup removal/inventory.",
    "deathSentence": "After byte decrement,1 expires;0 wraps255. Expiry stages removal and non-Undead Dead/return3; Undead continues lower effects.",
    "lowerEffects": "Stage Defending removal and +1 Brave iff Brave<10, without checking Chicken status; return2 iff resulting attack_type nonzero",
    "ai": "Only death-counter branch is execute-gated; Reraise and lower-section effects can still stage in AI/preview. Plain Dead without these effects still consumes first draw.",
    "arguments": "Body uses r5 unit pointer; documented r4 unit ID is not read. Caller selects CT>=100 and applies modulo first; no CT guard in helper."
  },
