  "report": "docs/behavior/ordinary-spell-ability-search.md",
  "sourceStudy": "docs/behavior/ordinary-spell-movement-origins.md",
  "routineMapping": {
    "ai_ability_outcome_evaluate": "OrdinarySpellAiAbilityEvaluation.AiAbilityOutcomeEvaluate: admitted ordinary caller groups, cumulative best and one decision RNG",
    "ai_cast_aim_tiles_build": "Existing BuildPotentialPasses/origin masks; remaining aims rebuilt by OriginReachableEvaluate on every pass",
    "target_enemies_with_move_opportunity_exclude": "Existing pass enumeration restores useful membership then excludes moving enemies only from tile usefulness",
    "origin_reachable_evaluate / origin_aim_tiles_evaluate": "Shared pass runner accepts only internally owned best seed; standalone queries still initialize fresh",
    "ai_action_evaluate / ai_rank_is_higher": "Shared strict priority/hit/final-destination comparison; exact ties retain earlier pass ownership",
    "ai_best_rank_insert / ai_action_rank_reset": "Final rank-only baseline gate is reported before insertion/reset; no ranked-list mutation, lottery or commands"
  },
  "callerProof": {
    "order": "ConsumeAim: Units; otherwise moving-by-deadline then still-at-deadline units. FollowTarget zero-area returns before tile path. Nonfollow uses tiles only.",
    "membership": "Saved useful mask restored after CT groups, then moving enemies removed for tile usefulness; peers remain formula recipients/accounting/scoring participants.",
    "masks": "ai_cast_aim_tiles_build clears aim rows and builds pass masks/counts afresh. Previous pass consumption cannot remove later aims.",
    "best": "No best reset between ordinary CT/unit/tile groups. ai_action_evaluate retains the shared best on nonvaluable attempts and exact ties.",
    "insertion": "Only final ordinary completion/zero-area return submits to ai_best_rank_insert; the query reports the rank-only baseline gate without insertion/reset.",
    "reflectedPrefix": "No Reflect recipients admitted; the source empty reflected prefix inserts/resets a fresh empty best without draws. No general reflected search is modeled.",
    "rng": "One fresh movement prefix; all candidates and caller groups share continuity. No extra dispatcher/insertion/lottery draws."
  },
