  "findings": {
    "shared": "Battle clock used by live gameplay and AI; mode Reset1 clears clock/unit counters and ends AI simulation; mode FindActiveUnit2 returns first present eligible source slot rather than checking CT",
    "order": "AddCT -> highest CT>=100 picks/upkeep -> charge countdown/ready -> status expiry/pending events; active-turn completion -> Poison/Regen -> terrain poison -> Transparent removal -> Mime/restore saved phase",
    "ct": "Slow takes precedence over Haste; floor(Speed/2), or Speed+floor(Speed/2); wide sum capped254; strict greater-than scan retains first source-slot tie; normal selected CT%=100, Quick255 resets0",
    "events": "UnitReady0x100, AbilityReady0x200, ActionResult0x300, Mime0x500 with unit ID low byte; None0xff00; Reset0xe000, first-unit lookup0xd000|id or0xdf00",
    "budgets": "Per-call1201 counted internal phase iterations differs from AI caller256 simulation-event limit (at most255 clock calls) and VSync suspension",
    "rng": "No direct RNG call in dispatcher; upkeep helper unconditionally draws before status branches. Plain dead AI units still draw/modulo but do not decay death counters or receive ordinary turns.",
    "annotationCorrections": [
      "PICK_UNIT selects all eligible highest-CT units, not only corpses",
      "FIND_ACTIVE_UNIT beq is consistent with returning a unit without the excluded statuses",
      "Phase15 is terrain poison; phase17 is Transparent removal; pasted comments swap them",
      "Index20/get-tile-type pointer is outside the dispatch table"
    ]
  },
