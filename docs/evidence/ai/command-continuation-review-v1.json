  "findings": [
    {
      "id": "COMMAND-435-01",
      "disposition": "verified-within-domain",
      "finding": "Native MOVE/ACT/END branch order and saved Move-first ACT versus fresh post-ACT selection match owned command paths; native no-progress/frame history is distinct from managed authority."
    },
    {
      "id": "COMMAND-435-02",
      "disposition": "verified-within-domain",
      "finding": "Current-invocation opaque proposals, actor/choice/profile guards and full-word/count forward RNG verification stage one real command atomically without adopting prediction as actual state."
    },
    {
      "id": "COMMAND-435-03",
      "disposition": "verified-within-domain",
      "finding": "Exact state/battle/revision/lineage/actor continuations freeze intent and use real post-Move admission/RNG; late failure preserves an accepted Move and retry/abandonment cannot cross branches."
    },
    {
      "id": "COMMAND-435-04",
      "disposition": "verified-within-domain",
      "finding": "Actual facing receipts and turn-stage precedence retain accepted partial progress, immutable priority successors and deterministic exact-session recovery; stop before next clock."
    },
    {
      "id": "COMMAND-435-05",
      "disposition": "deferred",
      "finding": "Managed atomicity/recovery is not native VSync resumption or save-token behavior. Automatic facing, host/frame/event integration, full corpse/terminal/status/special policies and broad magic commands remain separate."
    }
  ],
