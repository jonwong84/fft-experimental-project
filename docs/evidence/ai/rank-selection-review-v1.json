  "findings": [
    {
      "id": "RANK-434-01",
      "disposition": "verified-within-domain",
      "finding": "Fresh marker-zero signed priority/hit comparison, rank-only strict baseline gate, per-entry destination proximity ties and first full tie retained; null reset equivalence bounded by admitted physical score range."
    },
    {
      "id": "RANK-434-02",
      "disposition": "verified-within-domain",
      "finding": "Eight ranked slots preserve complete action occurrences, stable equal-rank insertion, shift/capacity and fresh per-entry best reset without deduplication."
    },
    {
      "id": "RANK-434-03",
      "disposition": "verified-within-domain",
      "finding": "Ordered raw%100<hit trials draw for every visited zero/certain slot, stop at first success, fall back to slot0 after all failures with any nonzero chance or movement after eight zeros."
    },
    {
      "id": "RANK-434-04",
      "disposition": "verified-within-domain",
      "finding": "Fresh/retained priority knowledge remains immutable/map-owned with unknown read rejection; source draws survive nonadmission while managed unsupported/counter failure rolls back the whole query."
    },
    {
      "id": "RANK-434-05",
      "disposition": "deferred",
      "finding": "Defend and wider policy/command/frame integration remain outside ordinary fallback certificates; magic current-origin best is not a full ranked decision; next checked-command review435 and final readability432 remain separate."
    }
  ],
