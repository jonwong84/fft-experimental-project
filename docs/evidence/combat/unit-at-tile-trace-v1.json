  "comparisons": {
    "statusFilterAndChocoboCombinations": 6144,
    "literalDescriptions": [
      {
        "name": "Negative X rejects before any Chocobo check",
        "input": {
          "x": -1,
          "y": 1,
          "layer": 0,
          "flags": 128,
          "units": {
            "0": {
              "chocobo": 1
            }
          }
        },
        "expectedReturn": -2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Unsigned invalid layer rejects",
        "input": {
          "x": 1,
          "y": 1,
          "layer": -1,
          "flags": 0,
          "units": {}
        },
        "expectedReturn": -2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Untargetable tile is invalid even with zero filters",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 0,
          "units": {},
          "tile_flags": 2
        },
        "expectedReturn": -2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Water is not a base query rejection",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 0,
          "units": {},
          "depth": 1
        },
        "expectedReturn": -1,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Dry low-slope flag rejects water",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 2,
          "units": {},
          "depth": 1
        },
        "expectedReturn": -2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Dry low-slope halfheight3 rejects",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 2,
          "units": {},
          "half": 3
        },
        "expectedReturn": -2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Dry low-slope halfheight2 is admitted",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 2,
          "units": {},
          "half": 2
        },
        "expectedReturn": -1,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Return slot index rather than active ID byte",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 0,
          "units": {
            "2": {
              "activeId": 9
            }
          }
        },
        "expectedReturn": 2,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Crystal or treasure are alternative matches",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 65,
          "units": {
            "0": {},
            "1": {
              "status": 2
            }
          }
        },
        "expectedReturn": 1,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Filtered no-match does not establish globally empty",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 16,
          "units": {
            "0": {}
          }
        },
        "expectedReturn": -1,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Zero filters never call Chocobo predicate",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 0,
          "units": {
            "0": {
              "chocobo": 0
            }
          }
        },
        "expectedReturn": 0,
        "expectedChocoboCallSlots": []
      },
      {
        "name": "Chocobo predicate precedes coordinate match",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 128,
          "units": {
            "0": {
              "chocobo": 1,
              "position": [
                2,
                2,
                0
              ]
            },
            "1": {
              "chocobo": 1
            }
          }
        },
        "expectedReturn": 1,
        "expectedChocoboCallSlots": [
          0,
          1
        ]
      },
      {
        "name": "Paired Chocobo state is accepted as nonzero",
        "input": {
          "x": 1,
          "y": 1,
          "layer": 0,
          "flags": 128,
          "units": {
            "0": {
              "chocobo": 2,
              "mount": 64
